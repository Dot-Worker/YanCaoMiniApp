page { background:#f6f5f0; color:#26372f; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; font-size:28rpx; line-height:1.6; }
view, text, button, input { box-sizing:border-box; }
button { min-height:44px; font-size:28rpx; font-weight:500; line-height:1.5; margin:0; padding:22rpx 26rpx; border-radius:18rpx; color:#285b4b; background:#edf2ec; text-align:center; }
button::after { border:0; }
button[disabled] { color:#737b76; background:#e9ebe6; }
button:active { opacity:.75; }
.page { padding:32rpx 32rpx 64rpx; padding-bottom:calc(64rpx + env(safe-area-inset-bottom)); }
.eyebrow { color:#496558; letter-spacing:3rpx; font-size:22rpx; font-weight:600; }
.title { word-break:break-all; overflow-wrap:break-word; margin:12rpx 0; font-size:48rpx; line-height:1.3; font-weight:650; letter-spacing:-1rpx; }
.subtitle { color:#65716a; font-size:27rpx; }
.section { margin-top:38rpx; }
.section-title { font-size:32rpx; font-weight:600; margin-bottom:18rpx; }
.section-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; }
.section-top .section-title { margin:0; }
.card { background:#fdfcf8; border:1rpx solid #dde3da; border-radius:24rpx; padding:28rpx; margin-bottom:20rpx; }
.row { display:flex; align-items:center; justify-content:space-between; }
.grow { flex:1; min-width:0; }
.muted { color:#65716a; }
.small { font-size:24rpx; }
.badge { display:inline-block; color:#426352; background:#edf2e9; border:1rpx solid #dae4d7; border-radius:8rpx; font-size:21rpx; padding:3rpx 12rpx; }
.note { margin-top:20rpx; color:#647068; font-size:24rpx; }
.health { border-left:5rpx solid #637c65; padding:20rpx 24rpx; background:#eaf0e7; border-radius:0 16rpx 16rpx 0; margin-top:32rpx; color:#435746; font-size:24rpx; }
.warning { padding:20rpx; background:#f4ede1; border-radius:14rpx; color:#65543a; font-size:24rpx; margin:20rpx 0; }
.search { display:flex; align-items:center; background:#fdfcf8; border:1rpx solid #ccd8cc; border-radius:18rpx; padding:6rpx 8rpx 6rpx 24rpx; margin:24rpx 0; min-height:92rpx; }
.search input { flex:1; min-width:0; height:80rpx; font-size:28rpx; }
.search button { background:transparent; padding:18rpx; min-width:44px; }
.search-entry { width:100%; text-align:left; margin:28rpx 0 18rpx; border:1rpx solid #cbd8cc; background:#fdfcf8; color:#55685b; padding:28rpx; }
.primary { color:#fff; background:#285b4b; }
.secondary { background:#edf2ec; color:#285b4b; }
.text-button { background:transparent; padding:14rpx 8rpx; font-size:25rpx; }
.empty { text-align:center; padding:60rpx 30rpx; background:#fdfcf8; border-radius:22rpx; border:1rpx dashed #cbd6cb; }
.empty-title { font-size:32rpx; font-weight:600; margin-bottom:12rpx; }
.empty button { margin-top:28rpx; }
.footer { text-align:center; font-size:23rpx; color:#65716a; padding:24rpx 0 0; }
.chips { display:flex; flex-wrap:wrap; margin:14rpx -6rpx 0; }
.chip { max-width:calc(100% - 12rpx); min-width:0; white-space:normal; word-break:break-all; overflow-wrap:break-word; padding:14rpx 20rpx; margin:6rpx; border-radius:40rpx; font-size:25rpx; font-weight:400; background:#edf2e9; }
.break { word-break:break-all; }
