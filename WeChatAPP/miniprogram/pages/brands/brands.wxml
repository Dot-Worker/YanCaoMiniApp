<view class="page">
  <view class="eyebrow">DIRECTORY / 品牌目录</view><view class="title">按品牌查找</view><view class="subtitle">已见 {{allCount}} 个名称 · 不推测产地或品牌分类</view>
  <view class="search"><input value="{{query}}" bindinput="onInput" placeholder="搜索中文或英文品牌名称" maxlength="80" confirm-type="search" aria-label="搜索品牌名称"/><button wx:if="{{query}}" bindtap="clearSearch">清空</button></view>
  <view class="row filter"><text>只看已有详情资料</text><switch checked="{{availableOnly}}" color="#285B4B" bindchange="toggleAvailable" aria-label="只看已有详情资料"/></view>
  <view class="small muted results-label">{{total}} 个匹配品牌 · 按来源名称排序，非推荐</view>
  <view wx:if="{{total === 0}}" class="empty"><view class="empty-title">没有匹配的品牌</view><view class="muted">试试更短的名称，或查看全部已见目录。</view><button bindtap="showAll">查看全部已见品牌</button></view>
  <button wx:for="{{items}}" wx:key="id" class="brand-row" data-id="{{item.id}}" bindtap="openBrand"><view class="grow"><view class="name">{{item.name}}</view><view class="small muted">{{item.availableCount > 0 ? item.availableCount + ' 条详情已收录' : '目录已见 · 详情未采集'}}</view></view><text class="chevron">›</text></button>
  <button wx:if="{{hasMore}}" class="text-button" bindtap="loadMore">继续显示品牌</button><view wx:elif="{{total > 0}}" class="footer">已显示全部匹配品牌</view>
  <view class="health">吸烟有害健康。此目录不提供购买或使用建议。</view>
</view>
