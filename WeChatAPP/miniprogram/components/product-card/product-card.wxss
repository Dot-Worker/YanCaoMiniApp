.product { display:flex; align-items:center; width:100%; padding:24rpx 20rpx; margin:0 0 18rpx; border:1rpx solid #dde3da; border-radius:22rpx; background:#fdfcf8; color:#26372f; text-align:left; line-height:1.5; font-weight:400; }
.product::after { border:0; }
.picture { width:136rpx; height:146rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border-radius:14rpx; background:#f0f1eb; overflow:hidden; }
.image { width:132rpx; height:140rpx; }
.placeholder { display:flex; flex-direction:column; align-items:center; color:#59695c; font-size:20rpx; }
.placeholder-mark { font-size:40rpx; margin-bottom:8rpx; color:#829480; }
.body { margin-left:22rpx; flex:1; min-width:0; }
.brand { font-size:21rpx; color:#55735c; }
.name { font-size:29rpx; font-weight:600; margin:5rpx 0 9rpx; word-break:break-all; overflow-wrap:break-word; }
.meta,.date { font-size:22rpx; color:#69766d; }
.arrow { color:#78867a; font-size:38rpx; margin-left:14rpx; }
